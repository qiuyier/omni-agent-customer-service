# Reference only: the gateway does NOT automatically load .env files.
# Inject via your process manager/secret manager. Do not commit filled secrets.
# Missing identity/secret/database is intentional: checks must fail until set.
WEBCHAT_ADDRESS=127.0.0.1:8093
WEBCHAT_HOST_ID=
WEBCHAT_HOST_SECRET=
DATABASE_URL=
STORAGE_DRIVER=postgres
WEBCHAT_REPLY_MODE=fake
# Optional human desk. Empty disables; inject an array of source_id/id/secret
# from a secret manager. Never expose agent credentials to a browser.
WEBCHAT_AGENTS_JSON=

# Used only after explicitly selecting WEBCHAT_REPLY_MODE=ai.
AI_PROVIDER=custom
AI_PROTOCOL=chat_completions
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_MAX_CONCURRENT_REPLIES=8
# Optional FAQ: blank disables retrieval; [] explicitly supplies zero entries.
KNOWLEDGE_FAQ_PATH=
KNOWLEDGE_RETRIEVER=keyword
KNOWLEDGE_RETRIEVAL_TIMEOUT=2s
# Semantic indexing is a separate explicit choice; see docs/webchat-ai.md.
