# Unified AI provider configuration.
# Supported: openai, deepseek, glm, kimi, qwen, openrouter, siliconflow, custom.
AI_PROVIDER=openai

# Optional protocol override: responses or chat_completions.
# Leave empty to use the provider preset.
AI_PROTOCOL=

# Recommended credential variable. Never commit a real value.
# custom may leave it empty when the endpoint does not require authentication.
AI_API_KEY=

# Optional for OpenAI; required for every other provider.
AI_MODEL=

# Optional endpoint override; required when AI_PROVIDER=custom.
AI_BASE_URL=

# Dangerous opt-in for trusted non-loopback HTTP endpoints. Plain HTTP exposes
# the system prompt and complete customer conversation to the network.
AI_ALLOW_INSECURE_HTTP=false

# Optional customer-service system prompt override.
AI_SYSTEM_PROMPT=

# Process-local maximum for active model generations. Non-streaming and SSE
# replies share these slots; the value must be a positive integer.
AI_MAX_CONCURRENT_REPLIES=8

# Optional OpenRouter attribution headers; neither is a credential.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=

# Backward-compatible OpenAI variables. AI_* takes precedence when both exist.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

# Persistence adapter used by cmd/server: memory or postgres.
# memory needs no database but loses data when the process exits.
STORAGE_DRIVER=memory

# Required only when STORAGE_DRIVER=postgres. Quote this value when exporting
# it in a shell because URL query strings contain characters such as '?'.
DATABASE_URL=

# Explicit opt-in used only by PostgreSQL integration tests.
TEST_DATABASE_URL=

# Required by cmd/server for every /v1 request. Use a random value containing
# at least 32 bytes and no whitespace. Do not reuse an AI provider API key.
API_AUTH_TOKEN=

# Optional dedicated credential for GET /metrics. Empty disables the route.
# Use a random value of at least 32 bytes without whitespace, different from
# API_AUTH_TOKEN. Never reuse an AI API key. Does not consume /v1 rate limits.
METRICS_AUTH_TOKEN=

# Process-local token bucket shared by authenticated /v1 requests. Both values
# must be positive. A new process starts with API_RATE_LIMIT_BURST tokens.
API_RATE_LIMIT_RPS=20
API_RATE_LIMIT_BURST=40

# Shared structured logging for cmd/server. JSON is recommended in production;
# console is easier to read during local development.
# LOG_LEVEL: debug, info, warn, error. LOG_FORMAT: json, console.
LOG_LEVEL=info
LOG_FORMAT=json

# Hertz HTTP server listen address used by cmd/server.
HTTP_ADDRESS=127.0.0.1:8080

# Maximum graceful-drain time after SIGINT/SIGTERM. New /v1 requests are
# rejected immediately; admitted requests and SSE streams may finish within
# this budget. The default is longer than the 75s AI reply deadline.
SERVER_SHUTDOWN_TIMEOUT=90s
